# Frontend (Vite) settings. Copy to .env.local only if you need to override.
#
# Leave VITE_API_URL unset in normal use:
#   - `npm run dev`   -> http://localhost:5000
#   - production build (Vercel) -> same origin, i.e. /api/... on the same domain
# Set it only to point the frontend at a backend on another domain.
# VITE_API_URL=https://your-api.example.com
