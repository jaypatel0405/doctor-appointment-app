# Copy this file to .env and fill in your own values.

PORT=5000

# MongoDB connection string (Atlas or local)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-host>/medibook?retryWrites=true&w=majority

# Random string of at least 32 characters used to sign login tokens (HS256).
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# Changing it signs everyone out.
JWT_SECRET=change-this-to-a-long-random-secret-of-32-plus-chars
# Token lifetime (jsonwebtoken format, e.g. 12h, 1d, 7d). Default 1d.
JWT_EXPIRES_IN=1d

# Optional: email notifications. Leave blank to disable.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="MediBook+ <no-reply@medibook.com>"

# CORS allow list (comma-separated). Local dev origins (localhost:5173/4173),
# same-origin requests and Vercel deployment URLs are always allowed. Leave empty
# locally to allow any origin (outside production only).
# On Vercel set it to your deployed URL(s), e.g. https://medibook.jay-patel.dev
CORS_ORIGINS=

# Used only by `npm run seed:admin`. ADMIN_PASSWORD is required (12-128 chars).
ADMIN_EMAIL=admin@medibook.com
ADMIN_NAME=MediBook Admin
ADMIN_PASSWORD=

# ---------- Optional tuning (defaults shown) ----------
# Time zone that defines "today" when validating booking dates.
# APP_TIMEZONE=Asia/Kolkata
# bcrypt cost for new password hashes (4-15).
# BCRYPT_ROUNDS=12
# debug | info | warn | error | silent
# LOG_LEVEL=info
# Rate limits: failed logins per 15 min per IP, sign-ups per hour per IP,
# bookings/reschedules per 15 min per user, all API requests per minute per IP.
# RATE_LIMIT_LOGIN_MAX=10
# RATE_LIMIT_REGISTER_MAX=10
# RATE_LIMIT_BOOKING_MAX=20
# RATE_LIMIT_API_MAX=300
# Trust N proxy hops for the client IP (set automatically on Vercel). Only set
# this when running behind your own reverse proxy.
# TRUST_PROXY=1
# Let Mongoose create indexes on startup (off: use `npm run db:indexes`).
# MONGO_AUTO_INDEX=false
