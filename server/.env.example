# Copy this file to .env and fill in your own values.

PORT=5000

# MongoDB connection string (Atlas or local)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-host>/medibook?retryWrites=true&w=majority

# Long random string used to sign login tokens
JWT_SECRET=change-this-to-a-long-random-secret

# Optional: email notifications. Leave blank to disable.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="MediBook+ <no-reply@medibook.com>"

# CORS allow list (comma-separated). Local dev origins (localhost:5173/4173) and
# same-origin requests are always allowed. Leave empty locally to allow any origin.
# On Vercel set it to your deployed URL(s), e.g. https://medibook.vercel.app
CORS_ORIGINS=

# Used only by `npm run seed:admin`. ADMIN_PASSWORD is required (no default).
ADMIN_EMAIL=admin@medibook.com
ADMIN_NAME=MediBook Admin
ADMIN_PASSWORD=
